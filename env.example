# Environment template for __PROJECT_NAME__.
#
# This file is the committed twin of the real `.env`, which is gitignored. Copy it,
# fill it in, and never commit the result:
#
#     cp .env.example .env
#
# It is spelled `env.example` here, without the leading dot, because a template that
# carries a dotted `.env.example` invites an agent or a glob to treat it as a real env
# file. The scaffolding step writes the rendered project's copy out under the
# conventional dotted name.
#
# The rule this file exists to enforce: every environment file a project reads gets a
# committed `.example` twin documenting every key it expects. That is what separates
# "clone it and run it" from "clone it and ask someone which variables exist". A
# `devcontainer.json` that passes `--env-file .env` with no committed twin produces a
# container that fails on first boot, and a repository that commits a populated `.env`
# leaks every value in it permanently, because rewriting history does not un-leak a
# secret.
#
# Nothing below is a real credential. Anything that looks like one is a placeholder.
# Real values belong in `.env`, in your shell, or in the CI secret store.

# --- Application ---------------------------------------------------------------

# Display name and runtime environment. `production` turns on the stricter defaults
# in the application's own config loader, so set it deliberately.
APP_NAME=__PROJECT_NAME__
APP_ENV=development

# --- Model transport -----------------------------------------------------------

# Point this at whatever OpenAI-compatible endpoint this project is allowed to use.
# Leaving the placeholder in place keeps a fresh clone offline-safe.
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=change-me-not-a-real-key
LLM_MODEL=

# --- Storage -------------------------------------------------------------------

# The driver is the switch; the URL is only read by the driver you selected. The
# default sqlite path needs no server, so a fresh clone runs before you configure it.
DB_DRIVER=sqlite
DB_URL=sqlite:///./__PROJECT_MODULE__.db

# --- Observability -------------------------------------------------------------

# debug | info | warning | error. `debug` can log request bodies, so it is not a
# default and should never be set in a shared environment.
LOG_LEVEL=info

# --- Optional ------------------------------------------------------------------
#
# Uncomment only when the feature is actually wired up. A key present with an empty
# value is not the same as absent: code that asks "is the key set" will read the
# empty string as a configuration.
#
# Prefer the ambient credential (`gh auth login`, or whatever your CI injects) over
# putting a token in this file.
# GITHUB_TOKEN=
#
# Error reporting DSN. Unset disables reporting, which is the right default for a
# project that has not chosen a provider.
# SENTRY_DSN=
