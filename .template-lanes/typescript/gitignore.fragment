# Node, TypeScript and test junk. Nothing here is a source of truth.

# Dependencies - recreated by `npm ci` from the committed package-lock.json
node_modules/

# Test output - regenerated by `npm run test:coverage`; a committed copy is a stale
# claim about test health
coverage/

# Compiled output - derived from src/, and named in the tsconfig exclude list
dist/

# eslint's incremental cache - per-machine and per-version, so it is never portable
.eslintcache

# tsc's incremental state - invalid the moment any compiler option changes
*.tsbuildinfo

# typedoc output (`npm run docs:generate`), rebuilt from src/index.ts
docs/api/
